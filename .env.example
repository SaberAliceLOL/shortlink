# 复制为 .env 并按需修改；.env 永远不提交
APP_ENV=dev
PUBLIC_HOST=localhost:8000

# MySQL（docker compose 起的容器名）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=shortlink
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=shortlink

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 连接池 --------------------------------------------------------------
# 池大小必须配着 MySQL max_connections 一起算：
#   worker 数 × (DB_POOL_SIZE + DB_MAX_OVERFLOW) ≤ MySQL max_connections × 0.8
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=5.0
REDIS_MAX_CONNECTIONS=50
# 熔断能生效的前提：没有超时，Redis 挂起时请求会永远等下去
REDIS_SOCKET_TIMEOUT_SECONDS=0.5

# ---- 读缓存 --------------------------------------------------------------
CACHE_ENABLED=true
# none | mutex | logical_expire
# 默认逻辑过期：短链不可变，旧值不会错只会旧。详见 docs/cache.md
CACHE_STRATEGY=logical_expire
CACHE_TTL_SECONDS=300
# 雪崩防护：真实 TTL = ttl × (1 ± ratio)
CACHE_TTL_JITTER_RATIO=0.2
# 负缓存：不存在的短码也缓存，TTL 要短
CACHE_NEGATIVE_ENABLED=true
CACHE_NEGATIVE_TTL_SECONDS=60
CACHE_NEGATIVE_JITTER_RATIO=0.5
# 逻辑过期时 Redis 键比逻辑过期点多活的时长
CACHE_STALE_GRACE_SECONDS=600
CACHE_LOCK_TTL_MS=2000
CACHE_LOCK_WAIT_MS=50
CACHE_LOCK_WAIT_ATTEMPTS=3
CACHE_BREAKER_COOLDOWN_SECONDS=5.0

# ---- 穿透前置过滤 --------------------------------------------------------
# none | watermark | bloom
# 默认水位守卫：短码是 Base62(自增 ID)，ID 超水位就一定不存在
PREFILTER_STRATEGY=watermark
PREFILTER_REFRESH_SECONDS=1.0
PREFILTER_WATERMARK_MARGIN_STEPS=10
BLOOM_CAPACITY=1000000
BLOOM_ERROR_RATE=0.01

# ---- 埋点 ----------------------------------------------------------------
# Week 6 改成队列投递前先留开关：压测时关掉，避免 1:1 的 Redis 写干扰对比
HITS_RECORD_ENABLED=true

# ---- 事件循环（只影响 python -m app.runtime）-----------------------------
# asyncio | uvloop
BENCH_LOOP=asyncio
