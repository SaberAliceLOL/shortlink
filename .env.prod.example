# 生产环境变量模板：复制为 .env.prod 后改密码，.env.prod 不提交
APP_ENV=prod
# 公网访问地址：短链响应里的 short_url 用它拼接，必须是外网可达的域名或 IP
PUBLIC_HOST=101.200.80.105

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=shortlink
MYSQL_PASSWORD=CHANGE_ME_STRONG
MYSQL_DATABASE=shortlink
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
